# Copy to .env for local Docker use, or enter these values in Render.
# Never commit the copied .env file.
ConnectionStrings__NeonDBConnection=Server=YOUR_NEON_HOST;Database=neondb;User Id=YOUR_NEON_USER;Password=REPLACE_AFTER_ROTATION;SSL Mode=Require;Trust Server Certificate=true
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
Cors__AllowedOrigins__0=https://project-grogu-pi.vercel.app
# Reward-pool payments (Razorpay). Test keys start with rzp_test_. Optional: without
# them the payment endpoints answer 503. Webhook URL: <api>/api/v1/payments/webhook,
# events payment.captured, order.paid, payment.failed, same secret as below.
Razorpay__KeyId=
Razorpay__KeySecret=
Razorpay__WebhookSecret=

# Password-reset emails (Resend). Without a key no email is sent; in Development
# the link is written to the log instead.
Email__ResendApiKey=
Email__From=Grogu <no-reply@yourdomain.com>
App__FrontendUrl=https://project-grogu-pi.vercel.app

# Optional Cloudflare Turnstile for anonymous bug reports/reviews (pair with
# NEXT_PUBLIC_TURNSTILE_SITE_KEY on the frontend).
Turnstile__SecretKey=
